{
  "name": "learn-anything-pi-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "check:web": "tsc -p web/tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts src/planning/*.test.ts src/web/*.test.ts web/*.test.ts",
    "web:build": "node scripts/prepareStudyCamera.mjs && vite build --config web/vite.config.ts",
    "web": "npm run web:build && tsx src/web/gateway.ts",
    "camera:assets": "node scripts/prepareStudyCamera.mjs --download"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@lancedb/lancedb": "^0.39.0",
    "@mediapipe/tasks-vision": "1.1.0",
    "@mozilla/readability": "^0.6.0",
    "@octokit/rest": "^22.0.1",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^29.1.1",
    "katex": "^0.18.7",
    "typebox": "1.3.7",
    "undici": "^8.9.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.20.3",
    "@types/yauzl": "3.4.0",
    "playwright-core": "^1.63.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "^7.3.6"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  }
}
